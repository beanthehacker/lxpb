# Reports too large to commit raw comfortably (near/over GitHub's 100MB blob
# limit, or just bulky enough to bloat the repo) are committed as
# public/reports/**/*.html.gz instead and inflated by
# scripts/decompress-gz-reports.mjs (runs before dev/build) -- the inflated
# .html itself is a build artifact, not source, so list each one here.
public/reports/ss_m5_confl2/2026.html
public/reports/ss_m5_confl2/2025.html
public/reports/ss_m5_confl2/jul-aug.html
public/reports/ss_m5_allp0_2pt/jul-aug.html
public/reports/ss_m5_allp0_2pt/jul.html
public/reports/range_breakout/2025.html
public/reports/range_breakout/2026.html
# ss_m1_confl/sep.html runs from a fixed start day (--since-day) to "now": its
# committed .html.gz is only as fresh as the last time someone re-gzipped it
# after a regen (the renderer writes just the .html).
public/reports/ss_m1_confl/sep.html
public/reports/ss_m2_confl/sep.html
.vercel
.env*

# /levels dev runtime
levels_runtime/.dev_store/
levels_runtime/dev.log
npm_install.log

# per-machine cache of which .scid files were checked to be in time order
/data/scid_order_verified.json

# ss_m1_confl's M1 ledger cache: unlike h1_levels/m5_levels_continuous
# (the full persistent historical ledger, meant to be committed and
# extended incrementally), this is built fresh over whatever rolling
# "last N trading days" window happened to be current when it last ran --
# never worth versioning.
/data/levels_cache/m1_levels_recent.*
/data/levels_cache/m2_levels_recent.*
